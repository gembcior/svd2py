<?xml version="1.0" encoding="utf-8"?>

<device schemaVersion="1.3" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
  <vendor>Test Ltd.</vendor>
  <vendorID>Test</vendorID>
  <name>file9</name>
  <series>TestSeries</series>
  <version>1.1</version>
  <description>Test svd file with cluster, dimArrayIndex and sauRegionsConfig</description>
  <licenseText>MIT License</licenseText>
  <cpu>
    <name>CM33</name>
    <revision>r0p0</revision>
    <endian>little</endian>
    <mpuPresent>true</mpuPresent>
    <fpuPresent>false</fpuPresent>
    <fpuDP>false</fpuDP>
    <dspPresent>false</dspPresent>
    <icachePresent>false</icachePresent>
    <dcachePresent>false</dcachePresent>
    <itcmPresent>false</itcmPresent>
    <dtcmPresent>false</dtcmPresent>
    <vtorPresent>true</vtorPresent>
    <nvicPrioBits>3</nvicPrioBits>
    <vendorSystickConfig>false</vendorSystickConfig>
    <deviceNumInterrupts>5</deviceNumInterrupts>
    <sauNumRegions>2</sauNumRegions>
    <sauRegionsConfig enabled="true" protectionWhenDisabled="s">
      <region enabled="true" protectionWhenDisabled="s">
        <base>0x10000000</base>
        <limit>0x10007FFF</limit>
        <access>n</access>
      </region>
      <region enabled="false">
        <base>0x10010000</base>
        <limit>0x10017FFF</limit>
        <access>c</access>
      </region>
    </sauRegionsConfig>
  </cpu>
  <headerSystemFilename>system_TEST</headerSystemFilename>
  <headerDefinitionsPrefix>TEST_</headerDefinitionsPrefix>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <access>read-write</access>
  <protection>n</protection>
  <resetValue>0</resetValue>
  <resetMask>0xffffffff</resetMask>
  <peripherals>
    <peripheral>
      <name>TestClusterPeripheral</name>
      <version>1.0</version>
      <description>Test peripheral with a register cluster</description>
      <baseAddress>0x40003000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <protection>n</protection>
      <resetValue>0</resetValue>
      <resetMask>0xffffffff</resetMask>
      <registers>
        <cluster>
          <name>CH0</name>
          <description>Channel 0 register set</description>
          <addressOffset>0x0</addressOffset>
          <register>
            <name>CTRL</name>
            <description>Channel control register</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <protection>n</protection>
            <resetValue>0</resetValue>
            <resetMask>0xffffffff</resetMask>
            <fields>
              <field>
                <name>SRC</name>
                <description>Source select, indexed field</description>
                <dim>2</dim>
                <dimIncrement>1</dimIncrement>
                <dimArrayIndex>
                  <headerEnumName>SRC_SELECT</headerEnumName>
                  <enumeratedValue>
                    <name>SRC0</name>
                    <description>Source channel 0</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SRC1</name>
                    <description>Source channel 1</description>
                    <value>1</value>
                  </enumeratedValue>
                </dimArrayIndex>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
      </registers>
    </peripheral>
  </peripherals>
</device>
