<?xml version="1.0" encoding="utf-8"?>

<device schemaVersion="1.3" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
  <vendor>Test Ltd.</vendor>
  <vendorID>Test</vendorID>
  <name>file10</name>
  <series>TestSeries</series>
  <version>1.0</version>
  <description>Test svd file for enumeratedValues derivedFrom</description>
  <licenseText>MIT License</licenseText>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <access>read-write</access>
  <resetValue>0</resetValue>
  <resetMask>0xffffffff</resetMask>
  <peripherals>
    <peripheral>
      <name>TestPeripheral</name>
      <baseAddress>0x40000000</baseAddress>
      <registers>
        <register>
          <name>RegA</name>
          <description>Register with the origin enumeratedValues sections</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0</resetValue>
          <fields>
            <field>
              <name>FieldA</name>
              <description>Origin field with a device-wide unique enumeratedValues name</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <name>UniqueEnum</name>
                <usage>read-write</usage>
                <enumeratedValue>
                  <name>disabled</name>
                  <description>Disable device</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>enabled</name>
                  <description>Enable device</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FieldB</name>
              <description>Derives its enumeratedValues by a bare, unqualified name</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues derivedFrom="UniqueEnum">
                <name>UniqueEnumCopy</name>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>RegB</name>
          <description>Register whose fields reuse an enumeratedValues name that is not unique device-wide</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0</resetValue>
          <fields>
            <field>
              <name>FieldC</name>
              <description>One of two fields sharing the same enumeratedValues name</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <name>DupEnum</name>
                <usage>read-write</usage>
                <enumeratedValue>
                  <name>off</name>
                  <description>Off state</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>on</name>
                  <description>On state</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FieldF</name>
              <description>The other field sharing the same enumeratedValues name, to force disambiguation</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <name>DupEnum</name>
                <usage>read-write</usage>
                <enumeratedValue>
                  <name>low</name>
                  <description>Low state</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>high</name>
                  <description>High state</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FieldD</name>
              <description>Derives its enumeratedValues qualified by the origin field name</description>
              <bitOffset>8</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues derivedFrom="FieldC.DupEnum">
                <name>DupEnumFromFieldC</name>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>
